# What the Burst sentinel may do. Claude edits this file and commits; the sentinel re-reads it every minute.
#   ENABLED=0  -> submit nothing new (running tasks finish; nothing is cancelled)
#   ENABLED=1  -> submit every ready task in tasks/ (see README for the task header format)
ENABLED=1
ACCOUNT=ds_ga_1011-2026fa
CPU_PARTITION=n2c48m24
GPU_PARTITION=c12m85-a100-1
# at most this many GPU tasks queued/running at once (each holds 1 A100 40GB)
MAX_GPU_JOBS=1
# stop submitting GPU tasks once finished GPU tasks have used this many hours (account total is 300)
GPU_HOURS_BUDGET=120
